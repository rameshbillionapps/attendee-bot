# PostgreSQL Configuration
POSTGRES_DB=attendee_production
POSTGRES_USER=attendee_user
POSTGRES_PASSWORD=your_secure_password_here

# Django Configuration
ALLOWED_HOSTS=*
DJANGO_SSL_REQUIRE=false
DISABLE_EMAIL=false

# Email Configuration (if DISABLE_EMAIL=false)
EMAIL_HOST=smtp.mailgun.org
EMAIL_HOST_USER=your_email_host_user
EMAIL_HOST_PASSWORD=your_email_host_password
DEFAULT_FROM_EMAIL=noreply@mail.attendee.dev

# Optional: Error reporting
ERROR_REPORTS_RECEIVER_EMAIL_ADDRESS=admin@example.com

# Optional: CSRF trusted origins (comma-separated)
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Optional: Server email for system-generated emails
# SERVER_EMAIL=noreply@mail.attendee.dev

# Optional: Log level
# ATTENDEE_LOG_LEVEL=INFO

# Optional: Disable admin interface
# DISABLE_ADMIN=false

# Optional: Database SSL requirement (set to 'false' if using local database)
# POSTGRES_SSL_REQUIRE=false

# Optional: Disable server-side cursors (useful with PgBouncer)
# DISABLE_SERVER_SIDE_CURSORS=false
